env=dev

# Optional future public HTTPS origin. Do not expose the prototype.
# AUTH_PUBLIC_ORIGIN=https://auth.example.com

# Optional. Enable only with a real TLS SMTP relay, never commit credentials.
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-app-specific-password
# MAIL_FROM=auth@example.com

# Optional OIDC internal RS256 signing (requires external HTTPS issuer)
# AUTH_PUBLIC_ORIGIN=https://auth.example.com
# OIDC_SIGNING_KID=oidc-2026
# OIDC_SIGNING_KEY_FILE=/secure/absolute/path/oidc-2026.private.pem
# OIDC_OLD_PUBLIC_KEYS_DIR=/secure/absolute/path/old-public-keys
