env=dev

# Optional future public HTTPS origin. Do not expose the prototype.
# AUTH_PUBLIC_ORIGIN=https://auth.example.com

# Optional. Enable only with a real TLS SMTP relay, never commit credentials.
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-app-specific-password
# MAIL_FROM=auth@example.com
