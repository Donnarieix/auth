# Donnarieix Auth local development (binds only 127.0.0.1:3000).
# Leave AUTH_PUBLIC_ORIGIN unset for local HTTP and auto-generated local RSA key.
# AUTH_LOCAL_OUTBOX_DIR=data/outbox
#
# Optional public HTTPS configuration ONLY when staging/production deployment
# is separately hardened. This setting does not itself provide TLS.
# AUTH_PUBLIC_ORIGIN=https://auth.example.com
# OIDC_SIGNING_KID=oidc-production-01
# OIDC_SIGNING_KEY_FILE=/secure/absolute/path/oidc.private.pem
# OIDC_OLD_PUBLIC_KEYS_DIR=/secure/absolute/path/public-keys
#
# Optional real email delivery (not required for local development).
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-app-specific-password
# MAIL_FROM=auth@example.com
