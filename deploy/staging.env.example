# Copy to /etc/donnarieix-auth/auth.env (root-owned, mode 0600).
# The externally accessible hostname must match the certificate SAN.
AUTH_PUBLIC_ORIGIN=https://auth-test.donnarieix.fr
OIDC_SIGNING_KID=staging-key-2026-01
OIDC_SIGNING_KEY_FILE=/var/lib/donnarieix-auth/keys/oidc.private.pem
# Email workflows require a real TLS SMTP relay in HTTPS mode.
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=
