# Install in the Debian CT at /etc/donnarieix-auth/auth.env (0600 root).
# Public HTTPS issuer is the *Nginx* hostname, not the private CT IP.
AUTH_PUBLIC_ORIGIN=https://auth-test.donnarieix.fr
# Only bind this specific private LXC interface, never 0.0.0.0.
# Protect TCP/3000 using the Proxmox/CT firewall: permit infra-static only.
AUTH_LISTEN_ADDR=192.168.1.142:3000
OIDC_SIGNING_KID=staging-key-2026-01
OIDC_SIGNING_KEY_FILE=/var/lib/donnarieix-auth/keys/oidc.private.pem
# HTTPS-mode registration requires a real SMTP relay to send validation codes.
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=
